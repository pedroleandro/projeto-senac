# Copie este arquivo para .env ao usar Docker
# cp .env.docker .env

APP_URL=http://localhost:8080
APP_NAME="Projeto Senac"
APP_TIMEZONE=America/Sao_Paulo
APP_DEVELOPER="Seu Nome Aqui"

# Banco — 'db' é o nome do container MySQL no docker-compose
